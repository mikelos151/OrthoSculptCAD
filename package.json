{
  "name": "orthosculpt-cad",
  "version": "0.2.0",
  "description": "Open-source technical CAD suite for lower-limb prosthetics socket rectification and alignment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikelos151/OrthoSculptCAD.git"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/server.mjs",
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:build": "tauri build --no-bundle",
    "native:test": "cargo test --release --manifest-path crates/ortho-geometry/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "fflate": "^0.8.2",
    "earcut": "^3.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "8.3.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}